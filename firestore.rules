rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: allow read for LRN→email lookup (happens before login, no auth yet) and for login/admin (authenticated).
    // Note: Public read exposes LRN/email mapping. For stricter security, use a separate lrn_lookup collection.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Progress: users read/write own; admin dashboard needs read-all (any authenticated user can read)
    match /progress/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Scores: users read/write own; admin needs read-all
    match /scores/{userId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Achievements: users read/write own; admin needs read-all
    match /achievements/{userId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Activity meta: users read/write own; admin needs read-all
    match /activity_meta/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Password reset requests: students create when not logged in; admin reads/updates when logged in
    match /password_reset_requests/{docId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }
  }
}
